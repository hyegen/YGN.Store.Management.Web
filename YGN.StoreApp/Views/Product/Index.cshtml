@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<YGN.StoreApp.Entities.Dtos.ProductGetAllDto>

<div class="row">
    <div class="col-md-3">

        @*     @await Component.InvokeAsync("CategoriesMenu")
        @await Component.InvokeAsync("ProductFilterMenu") *@
        <div products="" number="3"></div>
    </div>
    <div class="col-md-9">

        <div class="row my-3">
            @foreach (var item in Model)
            {
                <partial name="_ProductCard" model="@item" />
            }
        </div>
        <div class="row">

            @Html.PagedListPager((IPagedList)Model, page => Url.Action("Index", new { page }), new PagedListRenderOptions()
            {
                LiElementClasses = new string[] { "page-item" },
                PageClasses = new string[] { "page-link" }
            })
        </div>
    </div>
</div>

@section Footer {

}

