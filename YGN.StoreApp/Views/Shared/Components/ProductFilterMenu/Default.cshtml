@* @model IEnumerable<Product> *@
@* @model ProductListViewModel *@

@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<YGN.StoreApp.Entities.Dtos.ProductGetAllDto>

<div class="my-3">
    <h6 class="lead">
        <i class="fa fa-filter text-secondary"></i>
        Filters
    </h6>
</div>

<div class="my-2">
    <form method="post" asp-action="Index">

        <input type="hidden" name="categoryId" value="@(Context.Request.Query["categoryId"])" />

        <div class="form-group my-2">
            <input class="form-control" name="SearchTerm" placeholder="Search" />
        </div>

        <div class="form-group my-2">
            <input class="form-control" name="MinPrice" placeholder="Min Price" />
        </div>

        <div class="form-group my-2">
            <input class="form-control" name="MaxPrice" placeholder="Max Price" />
        </div>

        <div class="form-group my-2">
            <button type="submit" class="btn btn-sm btn-primary">Filter</button>
            <a href="@Url.Action("Index", new { categoryId = Context.Request.Query["categoryId"] })" class="btn btn-sm btn-secondary">Clear Filter</a>
        </div>
    </form>
</div>